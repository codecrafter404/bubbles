type CustomItem {
  "should be unique across items/customitems"
  id: Int!
  name: String!
  "the dependency of the item for building a tree (only custom items)"
  dependsOn: Int
  variants: [Item!]!
  "wheather multiple variants can be selected at once"
  exclusive: Boolean!
}

input NewCustomItem {
  id: Int!
  name: String!
  dependsOn: Int
  variants: [Int!]!
  exclusive: Boolean!
}

input UpdateCustomItem {
  name: String
  exclusive: Boolean
}
